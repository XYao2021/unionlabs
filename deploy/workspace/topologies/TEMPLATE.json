// -----------------------------------------------------------------------
//  TEMPLATE — copy this, rename it, replace both REPLACE_ME serials.
//  A two-node radio pair: data over the air, ACK back over TCP.
//
//  NOT RUNNABLE AS IT STANDS. A run refuses a file with a REPLACE_ME in it,
//  and ./run.sh topologies marks it DRAFT, so it cannot start by accident.
//
//  FILL IN
//    1. Both serials — `uhd_find_devices` on each box. Prefer serial over
//       addr: 192.168.40.2 is UHD's default for an X310, so two machines
//       answer to it and both containers would claim the same node.
//    2. freq_mhz — `python3 union/phy_profile.py --common` after
//       prepare.sh lists the spectrum every surveyed radio can use. Give
//       SEVERAL, best first: the survey picks the first it still measures
//       as usable, so the file does not go stale.
//    3. subdev / ant must match what prepare.sh surveyed, or the
//       measurement is filed where nothing looks for it.
//
//  After prepare.sh you do not need this file at all: the survey writes a
//  draft with the receive side already filled in. See
//  ./prepare.sh --topology-only.
//
//  For an ACK over the air: set down to wireless and give each node a
//  second RF block on a DIFFERENT subdev with its own carrier pool. An RF
//  ACK is the second RF path; one subdev doing both means the transmitter
//  swamps its own receiver.
// -----------------------------------------------------------------------
{
  "schema": 1,
  "name": "TEMPLATE",
  "algo": "echo",
  "description": "Starting point for a two-node radio pair: data over the air, ACK over TCP.",
  "defaults": {
    "channel": "usrp",
    "scheme": "QPSK",
    "waveform": "sc",
    "fec": "turbo",
    "steps": 10,
    "max_attempts": 50,
    "det_mult": 30,
    "sync_threshold": 15,
    "bytes_length": 1000
  },
  "nodes": [
    {
      "id": "src",
      "role": "tx",
      "radio": {
        "device": "x310",
        "serial": "REPLACE_ME_SOURCE_SERIAL",
        "tx": { "ant": "TX/RX", "subdev": "A:0", "gain": 25,
                "freq_mhz": [2404.5, 2422.5, 2440.5] }
      }
    },
    {
      "id": "snk",
      "role": "rx",
      "ports": { "ack": 5599 },
      "radio": {
        "device": "x310",
        "serial": "REPLACE_ME_SINK_SERIAL",
        "rx": { "ant": "RX2", "subdev": "A:0", "gain": 20,
                "freq_mhz": [2404.5, 2422.5, 2440.5] }
      }
    }
  ],
  "links": [
    {
      "from": "src",
      "to": "snk",
      "medium": { "up": "wireless", "down": "tcp" }
    }
  ]
}
