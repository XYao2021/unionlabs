# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
#  unionlabs — ONE self-contained image:
#    1. downloads the platform from GitHub (no build context needed),
#    2. runs deploy/initialization.sh to install the whole toolchain,
#    3. serves a desktop over noVNC with NO PASSWORD.
#
#  Unlike Dockerfile / Dockerfile.novnc (which COPY the local tree and layer in two
#  steps), this one clones the public repo, so you can build it anywhere — including
#  straight from a URL with no checkout at all:
#
#      docker build -t unionlabs -f deploy/Dockerfile.unionlabs .
#      docker build -t unionlabs https://github.com/XYao2021/unionlabs.git#main:deploy \
#             -f Dockerfile.unionlabs
#
#  Run, then open  http://<host>:6080/vnc.html?autoconnect=1  — no password prompt:
#      docker run -d --name unionlabs -p 6080:6080 unionlabs
#      docker run -d --name unionlabs --network host unionlabs        # + USRP (N210)
#      docker run -d --name unionlabs -p 6080:6080 \
#                 --device /dev/bus/usb unionlabs                      # + B210 over USB
#
#  Build knobs:
#      --build-arg UNIONLABS_REPO=<url>     a fork
#      --build-arg UNIONLABS_REF=<branch>   a branch/tag/commit          (default main)
#      --build-arg INIT_ARGS="--minimal"    skip torch/networkx/opencv   (smaller image)
#      --build-arg INIT_ARGS="--build"      also compile sdr_system + pyphy
# ─────────────────────────────────────────────────────────────────────────────
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG UNIONLABS_REPO=https://github.com/XYao2021/unionlabs.git
ARG UNIONLABS_REF=main
# Points at the ref's current commit. Its CONTENT changes whenever the branch moves,
# which is what actually invalidates the clone layer below — see the note there.
ARG UNIONLABS_REFS_URL=https://api.github.com/repos/XYao2021/unionlabs/git/refs/heads/main
# What initialization.sh should do. Default installs the full Python stack but does
# NOT compile the C++ modem — add --build for that (slow, and only useful with a USRP).
# --cpu-torch matters: the default torch wheel drags in ~3.5 GB of CUDA runtime
# (nvidia/* and triton) that a container with no GPU can never use.
ARG INIT_ARGS="--no-images --cpu-torch"

# ── just enough to fetch the repo; initialization.sh installs everything else ──
RUN apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# ── 1. DOWNLOAD the platform ──
#    Fetching the ref's SHA first is what makes a rebuild honest. Docker caches a RUN
#    by its command string, so `git clone --branch main` is a cache hit forever even
#    after main has moved — a rebuild would silently ship stale code (it did, once).
#    ADD re-fetches this URL every build and invalidates the layer when the SHA
#    changes, so the clone below reruns exactly when there is something new.
ADD ${UNIONLABS_REFS_URL} /tmp/upstream-ref.json
WORKDIR /opt
RUN git clone --depth 1 --branch "${UNIONLABS_REF}" "${UNIONLABS_REPO}" unionlabs \
 && git -C unionlabs log --oneline -1

WORKDIR /opt/unionlabs

# ── 2. RUN the project's own installer ──
#    It is root-aware and non-interactive, so it works unchanged in a container.
#    PIP_NO_CACHE_DIR: pip's wheel cache is ~2.8 GB here and is dead weight in an
#    image — nothing will ever reinstall from it. Dropping the cache and the apt
#    lists in the same layer is what keeps them out of the history.
ENV PIP_NO_CACHE_DIR=1
RUN chmod +x deploy/initialization.sh \
 && ./deploy/initialization.sh ${INIT_ARGS} \
 && rm -rf /root/.cache /tmp/* /var/lib/apt/lists/*

# ── 3. the noVNC desktop ──
#    xvfb        headless X display (:0)          x11vnc   VNC server for it
#    novnc       the browser client               websockify  VNC -> websocket bridge
#    fluxbox     a minimal window manager         xterm    a terminal in the desktop
#    feh         quick viewer for figure.png      python3-tk  interactive matplotlib
RUN apt-get update && apt-get install -y --no-install-recommends \
      xvfb x11vnc fluxbox novnc websockify \
      feh xterm python3-tk iproute2 \
 && rm -rf /var/lib/apt/lists/*

# ── 3a. ship noVNC 1.7.0, not Ubuntu's 1.0.0 from 2018 ──
#    1.0.0 computed its WebSocket URL from the hostname alone and persisted host/port
#    in localStorage — two entire classes of "Failed to connect to server" (wrong path
#    behind a prefix; stale localhost from an earlier visit) that we previously carried
#    patches for. 1.7.0 defaults host to EMPTY and resolves `new URL(path,
#    location.href)` relative to the page itself, so both are fixed upstream and the
#    patches are retired. Its error messages also name what actually failed.
ADD https://github.com/novnc/noVNC/archive/refs/tags/v1.7.0.tar.gz /tmp/novnc.tar.gz
RUN rm -rf /usr/share/novnc && mkdir -p /usr/share/novnc \
 && tar -xzf /tmp/novnc.tar.gz -C /usr/share/novnc --strip-components=1 \
 && rm /tmp/novnc.tar.gz \
 && grep -q "initSetting('host', '')" /usr/share/novnc/app/ui.js  # 1.7-family sanity check

# fcwu-style platforms open "/", and the Ubuntu novnc package has no index there.
RUN printf '%s\n' \
      '<!DOCTYPE html><html><head><meta charset="utf-8">' \
      '<meta http-equiv="refresh" content="0; url=vnc.html?autoconnect=1&resize=scale">' \
      '<title>unionlabs</title></head><body>' \
      '<a href="vnc.html?autoconnect=1&resize=scale">Open the desktop</a>' \
      '</body></html>' > /usr/share/novnc/index.html

# noVNC 1.0.0 shipped vnc_auto.html and older portal integrations hard-link it;
# 1.7.0 removed it. A shim keeps any such URL working.
RUN printf '%s\n' \
      '<!DOCTYPE html><html><head><meta charset="utf-8">' \
      '<meta http-equiv="refresh" content="0; url=vnc.html?autoconnect=1&resize=scale">' \
      '</head><body></body></html>' > /usr/share/novnc/vnc_auto.html

# ── 3b. stamp the build, so a running deployment can be identified ──
#    Which image is that pod actually running? On a platform that allocates a new port
#    per upload it is easy to keep testing the previous deployment for hours. The commit
#    goes into the noVNC web root (so `curl http://<host>:<port>/unionlabs-version.txt`
#    answers it from outside, with no shell access) and into the startup banner (so the
#    pod log answers it too).
RUN { git -C /opt/unionlabs log -1 --format='commit %H%nauthored %cI'; \
      echo "built   $(date -u +%Y-%m-%dT%H:%M:%SZ)"; } > /usr/share/novnc/unionlabs-version.txt \
 && cat /usr/share/novnc/unionlabs-version.txt



RUN cat > /usr/local/bin/start-unionlabs.sh <<'EOF' && chmod +x /usr/local/bin/start-unionlabs.sh
#!/usr/bin/env bash
# Bring up Xvfb -> fluxbox -> x11vnc -> noVNC, then hand control to CMD.
#
# The ordering here is deliberate: each step WAITS for the previous one instead of
# sleeping a guessed interval, because the classic noVNC "cannot connect to server"
# is x11vnc starting before Xvfb owns the display, or the web bridge starting before
# x11vnc listens.
#
# And when a step never arrives, this now DIES instead of carrying on. Serving the
# noVNC page over a dead backend is the worst failure available to us: the browser
# reports only "Failed to connect to server", which is indistinguishable from a
# reverse proxy refusing the WebSocket upgrade, so it sends you debugging the wrong
# layer. A container that exits with the reason in `docker logs` cannot mislead.
set -e
export DISPLAY=:0
RES="${RESOLUTION:-${VNC_RESOLUTION:-1440x900}}"   # RESOLUTION = fcwu-compat name
PORT="${NOVNC_PORT:-6080}"
HTTPPORT="${HTTP_PORT:-80}"

die() {   # die <message> [logfile]
  echo "[unionlabs] FATAL: $1" >&2
  if [ -n "${2:-}" ] && [ -s "$2" ]; then
    echo "[unionlabs] --- last 40 lines of $2 ---" >&2
    tail -n 40 "$2" >&2
  fi
  exit 1
}

await() { # await <tries, quarter-seconds each> <command...> — returns as soon as it holds
  local tries="$1"; shift
  for _ in $(seq 1 "$tries"); do "$@" >/dev/null 2>&1 && return 0; sleep 0.25; done
  return 1
}

x_display_up() { [ -S /tmp/.X11-unix/X0 ]; }
# ss is the real check; the bash /dev/tcp probe is a fallback so that a stripped-down
# container without iproute2 reports "down" only when the port really is down.
listening() { ss -ltn 2>/dev/null | grep -q ":$1 " || (exec 3<>/dev/tcp/127.0.0.1/"$1") 2>/dev/null; }

# Optional: pick up newer commits without rebuilding the image.
if [ "${REFRESH:-0}" = "1" ]; then
  echo "[unionlabs] REFRESH=1 — pulling latest ${UNIONLABS_REF:-main}"
  git -C /opt/unionlabs pull --ff-only || echo "[unionlabs] pull failed; keeping the baked-in copy"
fi

echo "[unionlabs] virtual display ${RES} on ${DISPLAY}"
Xvfb :0 -screen 0 "${RES}x24" -nolisten tcp >>/tmp/xvfb.log 2>&1 &
await 80 x_display_up || die "Xvfb never created /tmp/.X11-unix/X0 after 20s, so there is no display to export. This is usually a container that cannot write /tmp (read-only rootfs, or a volume mounted over it) or that the platform started as a user without permission to." /tmp/xvfb.log

fluxbox >/dev/null 2>&1 &
# a terminal already open in the repo, so the desktop is useful on arrival
(sleep 1; xterm -geometry 100x30+40+40 -T "unionlabs" -e "cd /opt/unionlabs && bash" >/dev/null 2>&1) &

# supervise x11vnc so the browser always has a live backend. -nopw = NO PASSWORD.
#
# The restart loop alone is not enough. The startup guards below cover STARTUP; an
# x11vnc that comes up and dies LATER leaves websockify serving a page that can never
# connect, and the browser reports the same "Failed to connect to server" while the pod
# looks healthy. Observed in the wild: websockify closing sockets with 1000 "Target
# closed" — it reached a backend that accepted and hung up, i.e. a flapping x11vnc
# caught between crashes. So once startup has finished, a crash LOOP is fatal: take the
# container down with the reason, and let the orchestrator restart it or the operator
# read it. Counting restarts costs nothing, unlike polling 5900, which would add a
# connect/disconnect pair to this very log every cycle.
( fails=0; window=$SECONDS
  while true; do
    x11vnc -display :0 -forever -shared -nopw -rfbport 5900 -noxdamage 2>&1 \
      | tee -a /tmp/x11vnc.log \
      | grep -E --line-buffered 'accepted_client|client_count|client gone|[Ee]rror|[Ff]ail|refused|[Cc]annot' \
      | sed -u 's/^/[x11vnc] /' || true
    # only after the startup guards have had their say, so their clearer message wins
    if [ -e /tmp/.unionlabs-started ]; then
      [ $((SECONDS - window)) -gt 120 ] && { fails=0; window=$SECONDS; }
      fails=$((fails + 1))
      if [ "$fails" -ge 5 ]; then
        echo "[unionlabs] FATAL: x11vnc has died $fails times in under 2 minutes — the" >&2
        echo "[unionlabs] desktop is crash-looping, so every browser reaching this container" >&2
        echo "[unionlabs] would see only 'Failed to connect to server'. Stopping." >&2
        echo "[unionlabs] --- last 20 lines of /tmp/x11vnc.log ---" >&2
        tail -n 20 /tmp/x11vnc.log >&2
        # Stop the container by killing the CMD, NOT by `kill 1`: the kernel discards
        # signals sent to PID 1 from inside its own namespace unless PID 1 installed a
        # handler, and the usual CMD (sleep) installs none — so `kill 1` is silently a
        # no-op. The main script waits on this pid and exits when it dies.
        touch /tmp/.unionlabs-dead
        kill "$(cat /tmp/.unionlabs-cmd.pid 2>/dev/null)" 2>/dev/null
        exit 1
      fi
    fi
    echo "[unionlabs] x11vnc exited, restarting in 1s" >&2; sleep 1
  done ) &
await 60 listening 5900 || die "x11vnc is not listening on 5900 after 15s, so the desktop backend is dead. Refusing to serve a noVNC page that could only ever fail with 'Failed to connect to server'." /tmp/x11vnc.log

# Supervise the web bridge too. It is the half the browser actually talks to, and an
# unsupervised crash presents exactly like the proxy problem described above.
#
# --heartbeat pings every 30s. An idle VNC session sends nothing for minutes and load
# balancers drop silent WebSockets (an AWS ALB idles out at 60s by default), which the
# user sees as the desktop freezing and disconnecting for no reason. The flag is years
# old, but probe rather than assume: an unrecognised one would take the desktop down,
# and the probe is free.
HEARTBEAT=()
if websockify --help 2>&1 | grep -q -- '--heartbeat'; then
  HEARTBEAT=(--heartbeat=30)
else
  echo "[unionlabs] note: this websockify has no --heartbeat; a proxy may drop idle sessions"
fi
# Both logs go to the CONTAINER'S STDOUT as well as their files. On a managed platform
# the log pane is usually the only window into the pod, and the question that matters —
# did the browser's request ever arrive, and at which path — is answered by websockify
# logging "Path: '/...'" for every request. Without it the pod looks equally silent
# whether the proxy dropped the socket or the viewer never tried at all.
# x11vnc is filtered down to connection and failure lines on the way to stdout, because
# it out-talks websockify roughly ten to one and would bury the answer; /tmp/x11vnc.log
# still gets every line, which is what die() tails.
( while true; do
    websockify --web=/usr/share/novnc "${HEARTBEAT[@]}" "${PORT}" localhost:5900 2>&1 \
      | tee -a /tmp/websockify.log | sed -u 's/^/[websockify] /' || true
    echo "[unionlabs] websockify exited, restarting in 1s" >&2; sleep 1
  done ) &
await 60 listening "${PORT}" || die "websockify is not listening on ${PORT} after 15s, so nothing is serving the browser." /tmp/websockify.log

# fcwu/docker-ubuntu-vnc-desktop contract: platforms built around that image forward
# their external port to container:80 and open "/". Serve the identical desktop there
# too, so this image works whichever port the platform wired. Failure to bind 80 is a
# warning, not fatal — 6080 is already serving.
if [ "${HTTPPORT}" != "${PORT}" ]; then
  ( while true; do
      websockify --web=/usr/share/novnc "${HEARTBEAT[@]}" "${HTTPPORT}" localhost:5900 2>&1 \
        | tee -a /tmp/websockify80.log | sed -u 's/^/[websockify:80] /' || true
      echo "[unionlabs] websockify:80 exited, restarting in 1s" >&2; sleep 1
    done ) &
  await 40 listening "${HTTPPORT}" \
    || echo "[unionlabs] WARNING: could not bind ${HTTPPORT}; only ${PORT} is serving" >&2
fi

echo "[unionlabs] ready — open  http://<host>:${PORT}/vnc.html?autoconnect=1  (no password)"
sed 's/^/[unionlabs] build: /' /usr/share/novnc/unionlabs-version.txt 2>/dev/null || true
echo "[unionlabs] the same stamp is served at  /unionlabs-version.txt  — use it to tell"
echo "[unionlabs] which upload a deployment is actually running."
echo "[unionlabs] behind a proxy, that hop must forward the WebSocket upgrade. A path"
echo "[unionlabs] prefix needs nothing: the page derives its own socket path."
echo "[unionlabs] every request lands in this log — if nothing appears below when the"
echo "[unionlabs] browser tries, it never reached this container."
touch /tmp/.unionlabs-started      # from here on, an x11vnc crash loop is fatal

# Run CMD as a CHILD rather than exec-ing it, so this script stays PID 1 and the
# watchdog above has something it can actually signal. The trap keeps `docker stop`
# behaving as it did under exec, by forwarding the signal on.
"$@" &
CMD_PID=$!
echo "$CMD_PID" > /tmp/.unionlabs-cmd.pid
trap 'kill "$CMD_PID" 2>/dev/null' TERM INT
# `set -e` is on, and a killed child makes wait return non-zero — without the guard
# here the script dies at this line and never reports WHY it is going down.
status=0
wait "$CMD_PID" || status=$?
if [ -e /tmp/.unionlabs-dead ]; then
  echo "[unionlabs] exiting because the desktop backend died — see the FATAL above" >&2
  exit 1
fi
exit "$status"
EOF

# Documentation only; publishing is a `docker run -p` choice.
#   6080 = noVNC (browser)   5900 = raw VNC   5599/5700/5800+ = the platform's own ports
EXPOSE 80 6080 5900 5599 5700

ENV DISPLAY=:0 \
    VNC_RESOLUTION=1440x900 \
    NOVNC_PORT=6080 \
    SDR_SYSTEM_BIN=/opt/unionlabs/drivers/usrp/build/sdr_system

WORKDIR /opt/unionlabs
ENTRYPOINT ["/usr/local/bin/start-unionlabs.sh"]
CMD ["sleep", "infinity"]
