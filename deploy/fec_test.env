# fec_test.env — shared settings for run_sink.sh / run_source.sh
# Edit these ONCE per session, then launch tests with the wrapper scripts.
# (Each host uses the parts it needs: the N210 sink uses N210_ADDR; the B210
#  source uses B210_SERIAL + N210_HOST.)

# --- link / addressing ---
N210_HOST=10.245.80.237     # N210 host's LAN IP (source connects here for ACK). DHCP drifts:
                            #   check with `hostname -I` on the N210 host.
N210_ADDR=192.168.20.2      # N210 device address (on its private 192.168.20.x NIC)
B210_SERIAL=30CD424         # B210 TX device serial
ACKPORT=45999               # TCP ACK port (must be free on both hosts)
FREQ=915e6                  # carrier frequency

# --- rate chain (N210 clock: 2e6 / 1e6) ---
TXRATE=2e6
RXRATE=2e6
SYMRATE=1e6

# --- FEC block size (applies to LDPC AND turbo; must match on both ends) ---
K=256                       # try 512 for more coding gain (slower)

# --- sink stop behaviour (default = stop after the message is fully received) ---
SINK_MODE=stop              # stop = stop-after-finish (TCP ACK, then exit)
                            # serve = warm always-on AP (never stops; for continuous/MARL)
IDLE=30                     # sink gives up if no burst arrives within this many seconds
                            # (time to start the source in the other terminal)
MAXATT=50                   # source: give up on a chunk after N un-ACKed sends (0 = never)

# --- optional base config file for ALL other PHY options (advanced) ---
# Point this at a copy of phy.cfg to set any of the ~100 PHY options (timing loop,
# detector thresholds, OFDM fft/cp, ...). The script's FEC/scheme/gain flags still
# override it, so you change only what you need on top of the file's defaults.
# CONFIG=phy.cfg

# --- path to the binary (auto-detected if left blank) ---
# SDR=./build/sdr_system
