# Keep the build context small AND correct. The most important line is build/:
# never ship the host (macOS/arm64) build — it must be recompiled in-image for
# linux/amd64, or you get the "Exec format error" we already hit.
build/
**/build/
.git/
.gitignore

# Python caches
**/__pycache__/
*.pyc
*.pyo

# Large docs / assets — not needed to build or run the PHY
*.pdf
*.tex
slides/
figures/
viz/

# Scratch / data dirs
debugging/
received/
transmit/
**/results/
*.bin
**/*.bin

# macOS cruft
.DS_Store
**/.DS_Store

# The Docker files themselves don't need to be inside the image
docker/
