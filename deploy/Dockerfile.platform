# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
#  unionlabs-platform — the testbed platform's own SDR template + unionlabs.
#
#  This follows results/images/"working PHY"/Dockerfile — a template PROVEN to work
#  on the platform — as closely as possible, then adds the unionlabs repo where the
#  template's "/opt/application" slot expects code. The platform's contract, learned
#  from its default image and this template:
#    - Kubernetes runs the container; CMD tail -f /dev/null keeps it alive
#    - the PLATFORM execs /opt/TurboVNC/bin/vncserver into it and serves noVNC itself
#    - NO entrypoint, NO web stack in the image, xstartup launches Xfce
#  Deviations from the template are additive only: the unionlabs clone, its Python
#  deps, and a build marker readable from the desktop terminal.
# ─────────────────────────────────────────────────────────────────────────────
FROM ubuntu:22.04

ENV CI=true
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=America/New_York

# ── the template's package set, verbatim (GNU Radio + UHD + Xfce + tooling) ──
RUN apt-get update && apt-get install -y \
    software-properties-common gnupg2 wget curl git build-essential cmake \
    pkg-config autoconf automake libtool swig lsb-release ssh unzip vim nano \
    putty redis-tools net-tools iputils-ping iproute2 usbutils x11-apps \
    dbus-x11 xfce4 xfce4-goodies xfce4-terminal libjpeg-turbo-progs \
    mupdf \
    python3 python3-pip python3-dev python3-numpy python3-scipy \
    python3-matplotlib python3-pyqt5 python3-pyqtgraph python3-yaml \
    python3-requests python3-setuptools python3-wheel python3-zmq \
    python3-ruamel.yaml python3-mako python3-click python3-click-plugins \
    python3-click-threading python3-lxml python3-six python3-opengl \
    python3-serial gnuradio gnuradio-dev uhd-host libuhd-dev libusb-1.0-0 \
    libusb-1.0-0-dev libboost-all-dev libfftw3-dev libgsl-dev libsndfile1 \
    libsndfile1-dev liblog4cpp5-dev libzmq3-dev libspdlog-dev pybind11-dev \
    clang-format \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir pyserial pyqtgraph numpy scipy matplotlib \
    pyyaml mako requests ruamel.yaml

# ── TurboVNC, exactly as the template installs it ──
RUN wget -qO - https://packagecloud.io/dcommander/turbovnc/gpgkey | gpg --dearmor \
    | tee /usr/share/keyrings/turbovnc-archive-keyring.gpg > /dev/null && \
    echo "deb [signed-by=/usr/share/keyrings/turbovnc-archive-keyring.gpg] https://packagecloud.io/dcommander/turbovnc/any/ any main" \
    | tee /etc/apt/sources.list.d/turbovnc.list && \
    apt-get update && apt-get install -y turbovnc && \
    rm -rf /var/lib/apt/lists/* && \
    test -x /opt/TurboVNC/bin/vncserver

RUN mkdir -p /root/.vnc /opt/application /workspace

# ── UHD device images: the B200 series NEEDS them at runtime ──
#    A USB USRP (B210) has no persistent firmware: the host loads usrp_b200_fw.hex +
#    the FPGA image at every enumeration, so without these files in the container a
#    B210 testbed fails with "Could not find path for image". Network USRPs (N210)
#    boot from their own flash and never read these. -t b2xx keeps it to ~30 MB
#    instead of the full multi-hundred-MB set; initialization.sh's --no-images stays,
#    since this targeted download replaces the indiscriminate one.
RUN uhd_images_downloader -t b2xx \
 && test -f /usr/share/uhd/images/usrp_b200_fw.hex

# ── xstartup: TurboVNC 3.x ignores ~/.vnc/xstartup entirely ──
#    Its vncserver defaults $xstartup to the BUNDLED /opt/TurboVNC/bin/xstartup.turbovnc
#    unless $xstartup is set in /etc/turbovncserver.conf (verified in the vncserver
#    source: "if (!$xstartup) { $xstartup = $exedir.'xstartup.turbovnc' }"). So the
#    reference template's `COPY xstartup /root/.vnc/xstartup` never actually ran — the
#    desktop everyone sees is the bundled script.
#
#    We need a session-start hook (the shared workspace layout cannot be baked, because
#    the platform mounts over /workspace), so we point $xstartup at our own script — and
#    that script DELEGATES to the bundled one. That keeps the proven session behaviour
#    (dbus setup, window-manager detection, /etc/X11/Xsession) byte-for-byte and adds
#    only the hook.
RUN printf '%s\n' '$xstartup = "/root/.vnc/xstartup";' > /etc/turbovncserver.conf

RUN cat > /root/.vnc/xstartup <<'EOF' && chmod +x /root/.vnc/xstartup && cp /root/.vnc/xstartup /root/.vnc/xstartup.turbovnc
#!/bin/bash
# Session-start hook. Anything here must be harmless: a failure must never cost the
# user their desktop, hence the redirect and the `|| true`.
bash /opt/unionlabs/deploy/workspace/init-workspace.sh >/tmp/init-workspace.log 2>&1 || true

# The account's own libraries: bring the persistent environment up to date with
# env/requirements.txt (a hash no-op when unchanged) and put it on PATH for
# every terminal this desktop opens. Backgrounded: a first-time install must
# never delay the desktop.
setsid bash /opt/unionlabs/deploy/workspace/env/sync-env.sh \
  >/tmp/sync-env.log 2>&1 < /dev/null &
grep -q 'experiments/env/venv' /root/.bashrc 2>/dev/null || \
  echo 'export PATH=/workspace/experiments/env/venv/bin:$PATH' >> /root/.bashrc

# Publish what this node is (radios, addresses, PHYs) into the shared workspace, and keep
# the record's heartbeat fresh so it disappears when this session does. Detached and
# backgrounded: probing takes seconds and must never delay the desktop.
setsid python3 /opt/unionlabs/deploy/workspace/discover-node.py --daemon \
  >/tmp/discover-node.log 2>&1 < /dev/null &

# Hand off to TurboVNC's own session script — the one that has always actually run.
exec /opt/TurboVNC/bin/xstartup.turbovnc "$@"
EOF

# ── unionlabs, into the template's application slot ──
ARG UNIONLABS_REPO=https://github.com/XYao2021/unionlabs.git
ARG UNIONLABS_REF=main
ARG UNIONLABS_REFS_URL=https://api.github.com/repos/XYao2021/unionlabs/git/refs/heads/main
# The refs-API ADD invalidates this layer exactly when the branch moves (see
# Dockerfile.unionlabs for the full story of why an ARG alone does not).
ADD ${UNIONLABS_REFS_URL} /tmp/upstream-ref.json
RUN git clone --depth 1 --branch "${UNIONLABS_REF}" "${UNIONLABS_REPO}" /opt/unionlabs \
 && git -C /opt/unionlabs log --oneline -1 \
 && ln -s /opt/unionlabs /opt/application/unionlabs \
 && ln -s /opt/unionlabs /workspace/unionlabs

# --build compiles sdr_system AND the pyphy bindings against the image's own
# Python, so selftest runs 15/15 in the container and the N210 radio backend is
# ready without any on-testbed compile step. The template's toolchain (pybind11,
# libuhd-dev, Boost, FFTW) is exactly what the build needs.
ARG INIT_ARGS="--no-images --cpu-torch --build"
ENV PIP_NO_CACHE_DIR=1
RUN cd /opt/unionlabs && chmod +x deploy/initialization.sh \
 && ./deploy/initialization.sh ${INIT_ARGS} \
 && rm -rf /root/.cache /tmp/* /var/lib/apt/lists/*

# Build identity lives INSIDE the repo folder (not /workspace — see above), so it is
# visible right where the user works: ~/Desktop/unionlabs/BUILD_INFO.txt.
RUN { echo "unionlabs-platform"; git -C /opt/unionlabs log -1 --format='commit %H%nauthored %cI'; \
      echo "built   $(date -u +%Y-%m-%dT%H:%M:%SZ)"; } \
      > /opt/unionlabs/BUILD_INFO.txt && cat /opt/unionlabs/BUILD_INFO.txt

# Put unionlabs where the user looks first: on the Xfce desktop. The clone stays at
# /opt/unionlabs (the template's application slot, and what the docs reference); the
# desktop entry is a symlink, so both paths are the same tree.
# Only the repo goes on the desktop. Nothing may live in /workspace: the platform
# mounts its own volume there, which hides baked files and leaves dangling symlinks.
RUN mkdir -p /root/Desktop && ln -s /opt/unionlabs /root/Desktop/unionlabs


# ── the template's GNU Radio library paths, verbatim ──
ENV LD_LIBRARY_PATH=/usr/local/lib:/usr/local/lib/x86_64-linux-gnu
ENV PYTHONPATH=/usr/local/lib/python3.10/dist-packages:/usr/local/lib/python3/dist-packages
RUN echo "/usr/local/lib" > /etc/ld.so.conf.d/custom-gnuradio.conf && \
    echo "/usr/local/lib/x86_64-linux-gnu" >> /etc/ld.so.conf.d/custom-gnuradio.conf && \
    ldconfig

# PID 1. Same job as the template's `tail -f /dev/null` — keep the container alive so
# the platform can exec into it — but it also FORWARDS a graceful stop. Docker and
# Kubernetes signal PID 1 ONLY; every other process is SIGKILLed when the namespace is
# torn down, so a daemon's own SIGTERM handler never fires unless PID 1 passes the
# signal on. That is why a node's settings record outlived its session.
RUN cat > /usr/local/bin/stay-alive.sh <<'EOF' && chmod +x /usr/local/bin/stay-alive.sh
#!/bin/bash
cleanup() {
  pkill -TERM -f discover-node.py 2>/dev/null || true
  sleep 1                      # let it delete its record before we go
  exit 0
}
trap cleanup TERM INT
while true; do sleep 3600 & wait $!; done
EOF

WORKDIR /workspace
# Template contract: NO entrypoint; the platform execs TurboVNC into a container
# that is alive and otherwise idle.
CMD ["/usr/local/bin/stay-alive.sh"]
