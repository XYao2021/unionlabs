# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
#  novnc-minimal — a control image that satisfies the PLATFORM'S REAL CONTRACT.
#
#  The platform's default image revealed the contract nobody documented: the image
#  contains NO noVNC and NO websockify, installs TurboVNC + an Xfce session script
#  at /root/.vnc/xstartup, and its CMD is `tail -f /dev/null` — the container starts
#  and does NOTHING. The PLATFORM then execs /opt/TurboVNC/bin/vncserver into the
#  running container and serves the web side itself. Our previous images failed
#  because that exec found no TurboVNC: the platform's own noVNC page then reported
#  "Target closed" against a backend that never existed.
#
#  This image satisfies BOTH worlds:
#    platform contract   TurboVNC at its stock path, xstartup -> Xfce, CMD keeps the
#                        container alive doing nothing, exec-friendly
#    our own stack       TigerVNC Xvnc on :0/5900 + noVNC 1.7.0 on 80 and 6080, so a
#                        plain `docker run -p ...` still gives a browser desktop, and
#                        the version files still identify the build
#  Nothing our stack does can take the container down (STRICT=0 default): on this
#  platform the container MUST stay alive for the exec path even if our stack fails.
# ─────────────────────────────────────────────────────────────────────────────
FROM ubuntu:22.04

ENV CI=true
ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# ── the default image's package set (platform hooks may rely on any of it) ──
RUN apt-get update && apt-get install -y --no-install-recommends \
      software-properties-common gnupg2 wget lsb-release net-tools \
      awscli redis-tools curl ssh \
      xfce4 xfce4-goodies libjpeg-turbo-progs xfce4-terminal \
 && rm -rf /var/lib/apt/lists/*

# ── TurboVNC, exactly as the default image installs it ──
RUN wget -qO - https://packagecloud.io/dcommander/turbovnc/gpgkey | gpg --dearmor \
      | tee /usr/share/keyrings/turbovnc-archive-keyring.gpg > /dev/null \
 && echo "deb [signed-by=/usr/share/keyrings/turbovnc-archive-keyring.gpg] https://packagecloud.io/dcommander/turbovnc/any/ any main" \
      | tee /etc/apt/sources.list.d/turbovnc.list \
 && apt-get update && apt-get install -y turbovnc \
 && rm -rf /var/lib/apt/lists/* \
 && /opt/TurboVNC/bin/vncserver -help >/dev/null 2>&1 || true \
 && test -x /opt/TurboVNC/bin/vncserver   # the binary the platform will exec

# ── xstartup: the session TurboVNC launches. Xfce, like the default image. ──
RUN mkdir -p /root/.vnc && cat > /root/.vnc/xstartup <<'EOF' && chmod +x /root/.vnc/xstartup
#!/bin/sh
unset SESSION_MANAGER
unset DBUS_SESSION_BUS_ADDRESS
if command -v startxfce4 >/dev/null 2>&1; then exec startxfce4; fi
exec fluxbox
EOF
# TurboVNC 3.x reads ~/.vnc/xstartup.turbovnc, not xstartup (verified: an exec'd
# vncserver used its bundled default and auto-detected Xfce). Both names exist so
# every invocation the platform might use finds a session script.
RUN cp /root/.vnc/xstartup /root/.vnc/xstartup.turbovnc

# ── our own stack (independent of the platform's): TigerVNC + noVNC 1.7.0 ──
RUN apt-get update && apt-get install -y --no-install-recommends \
      tigervnc-standalone-server tigervnc-common websockify \
      fluxbox xterm x11-utils x11vnc iproute2 procps ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Empty VncAuth password for OUR Xvnc — kept OUT of /root/.vnc on purpose: the
# platform's TurboVNC reads ~/.vnc, and the default image ships no passwd file
# there, so putting one in would change TurboVNC's behaviour vs the reference.
RUN mkdir -p /etc/novnc-minimal \
 && x11vnc -storepasswd "" /etc/novnc-minimal/passwd \
 && chmod 644 /etc/novnc-minimal/passwd

ADD https://github.com/novnc/noVNC/archive/refs/tags/v1.7.0.tar.gz /tmp/novnc.tar.gz
RUN rm -rf /usr/share/novnc && mkdir -p /usr/share/novnc \
 && tar -xzf /tmp/novnc.tar.gz -C /usr/share/novnc --strip-components=1 \
 && rm /tmp/novnc.tar.gz \
 && grep -q "initSetting('host', '')" /usr/share/novnc/app/ui.js

RUN printf '%s\n' \
      '<!DOCTYPE html><html><head><meta charset="utf-8">' \
      '<meta http-equiv="refresh" content="0; url=vnc.html?autoconnect=1&resize=scale">' \
      '<title>desktop</title></head><body>' \
      '<a href="vnc.html?autoconnect=1&resize=scale">Open the desktop</a>' \
      '</body></html>' > /usr/share/novnc/index.html \
 && cp /usr/share/novnc/index.html /usr/share/novnc/vnc_auto.html

RUN { echo "novnc-minimal"; echo "built $(date -u +%Y-%m-%dT%H:%M:%SZ)"; \
      echo "stack TurboVNC(platform contract) + TigerVNC/noVNC-1.7.0(ours)"; } \
      > /usr/share/novnc/minimal-version.txt \
 && cat /usr/share/novnc/minimal-version.txt

RUN cat > /usr/local/bin/start-minimal.sh <<'EOF' && chmod +x /usr/local/bin/start-minimal.sh
#!/usr/bin/env bash
# Start OUR stack (TigerVNC :0/5900 + noVNC on 80 and 6080), then hand off to CMD.
# On this platform the container's ONLY hard obligation is to stay alive so the
# platform can exec TurboVNC into it — so failures here WARN loudly but never take
# the container down unless STRICT=1.
set -u
export DISPLAY=:0
GEOM="${RESOLUTION:-${VNC_GEOMETRY:-1280x800}}"
PORT="${NOVNC_PORT:-6080}"
HTTPPORT="${HTTP_PORT:-80}"
VNCPORT="${VNC_PORT:-5900}"

warn() { echo "[minimal] PROBLEM: $1" >&2; [ -n "${2:-}" ] && [ -s "$2" ] && tail -n 20 "$2" >&2
         [ "${STRICT:-0}" = 1 ] && exit 1; return 0; }
await() { local n="$1"; shift; for _ in $(seq 1 "$n"); do "$@" >/dev/null 2>&1 && return 0; sleep 0.25; done; return 1; }
listening() { ss -ltn 2>/dev/null | grep -q ":$1 " || (exec 3<>/dev/tcp/127.0.0.1/"$1") 2>/dev/null; }

echo "[minimal] our stack: Xvnc ${GEOM} on ${DISPLAY} (:${VNCPORT}), noVNC on :${HTTPPORT} and :${PORT}"
echo "[minimal] platform contract: /opt/TurboVNC/bin/vncserver is installed and exec-ready"
SEC="${VNC_SECURITY:-None,VncAuth}"
if [ -n "${VNC_PASSWORD:-}" ]; then
  x11vnc -storepasswd "${VNC_PASSWORD}" /etc/novnc-minimal/passwd >/dev/null 2>&1; SEC="VncAuth"
fi
Xvnc "${DISPLAY}" -geometry "${GEOM}" -depth 24 \
     -SecurityTypes "${SEC}" -PasswordFile /etc/novnc-minimal/passwd \
     -localhost no -AlwaysShared -rfbport "${VNCPORT}" -desktop minimal \
     2>&1 | sed -u 's/^/[Xvnc] /' | tee -a /tmp/xvnc.log &
await 80 listening "${VNCPORT}" || warn "our Xvnc never listened on ${VNCPORT}" /tmp/xvnc.log

fluxbox >/dev/null 2>&1 &
(sleep 1; xterm -geometry 100x28+40+40 -T minimal >/dev/null 2>&1) &

websockify --web=/usr/share/novnc "${PORT}" "localhost:${VNCPORT}" 2>&1 \
  | sed -u 's/^/[websockify] /' | tee -a /tmp/websockify.log &
await 60 listening "${PORT}" || warn "websockify never listened on ${PORT}" /tmp/websockify.log
if [ "${HTTPPORT}" != "${PORT}" ]; then
  websockify --web=/usr/share/novnc "${HTTPPORT}" "localhost:${VNCPORT}" 2>&1 \
    | sed -u 's/^/[websockify:80] /' | tee -a /tmp/websockify80.log &
  await 40 listening "${HTTPPORT}" || warn "could not bind ${HTTPPORT}" /tmp/websockify80.log
fi

echo "[minimal] ready"
sed 's/^/[minimal] build: /' /usr/share/novnc/minimal-version.txt 2>/dev/null || true
echo "[minimal] every web request is logged below; the platform may ALSO exec TurboVNC"
echo "[minimal] into this container (its display :1 = port 5901) — both can coexist."

trap 'exit 0' TERM INT
if [ "$#" -gt 0 ]; then "$@" & wait $! || true; else while true; do sleep 3600 & wait $!; done; fi
EOF

#   80/6080 our noVNC · 5900 our TigerVNC · 5901 TurboVNC once the platform starts it
EXPOSE 80 6080 5900 5901
ENV VNC_GEOMETRY=1280x800 NOVNC_PORT=6080 HTTP_PORT=80 VNC_PORT=5900 DISPLAY=:0 \
    VNC_SECURITY=None,VncAuth
ENTRYPOINT ["/usr/local/bin/start-minimal.sh"]
# Same CMD as the platform's default image: stay alive, do nothing, be exec-able.
CMD ["tail", "-f", "/dev/null"]
