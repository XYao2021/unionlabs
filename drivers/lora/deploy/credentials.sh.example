# credentials.sh — SSH login for the Pis. TEMPLATE ONLY.
#
# Copy this to  credentials.sh  (same folder) and fill it in. inventory.sh sources the
# real file automatically if it exists, and `credentials.sh` is in .gitignore, so the
# password never enters the repository.
#
#   cp credentials.sh.example credentials.sh
#   $EDITOR credentials.sh
#
# NEVER put a real password in THIS file — it is committed.
#
# ── Preferred: use SSH keys and skip this file entirely ─────────────────────
#   ssh-keygen -t ed25519                 # once
#   ssh-copy-id pi01@100.93.81.78         # once per Pi (see DEVICES.md for the list)
# With keys in place, leave credentials.sh absent and everything works.
#
# ── Otherwise: a shared password, supplied through sshpass ──────────────────
# Leave SSH_USER empty to keep the testbed convention, where each node logs in as
# its own hostname (pi04 logs in as user pi04).
export SSH_USER=""              # e.g. "pi" only if every Pi shares one account
export SSH_PASS="changeme"      # the login password; requires sshpass

# The password is handed to sshpass through the environment (sshpass -e), never on a
# command line, so it does not appear in `ps` output or your shell history.
