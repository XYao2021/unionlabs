{
  "_comment": "8-PSK single-carrier ARQ pair. Validated gains from COMMANDS.md (RX 16 / TX 86, sc — 8-ary needs more TX power, lower RX gain). Start RX first:  run.py configs/8psk.json --only rx   |   --only tx",
  "common": {
    "rx_freq": 915e6, "tx_freq": 915e6,
    "rx_rate": 1.6e6, "tx_rate": 1.6e6,
