{
  "_comment": "Two-box QPSK stop-and-wait ARQ over the air/cable. Runs BOTH ends.",
  "common": {
    "rx_freq": 915e6, "tx_freq": 915e6,
    "rx_rate": 1.6e6, "tx_rate": 1.6e6,
    "rx_subdev": "A:A", "tx_subdev": "A:A",
    "rx_ant": "RX2", "tx_ant": "TX/RX",
    "scheme": "QPSK", "fec": true,
    "ack_transport": "tcp", "ack_port": 5599, "det_mult": 3
  },
  "rx": { "role": "sink_arq",   "rx_args": "serial=30CD3F7", "tx_args": "serial=30CD3F7", "rx_gain": 20 },
  "tx": { "role": "source_arq", "tx_args": "serial=30CD424", "rx_args": "serial=30CD424", "tx_gain": 78,
          "ack_host": "127.0.0.1", "timeout": 3000 },
  "pair": { "rx_head_start": 4, "rx_grace": 30 }
}
