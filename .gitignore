# CMake build tree (regenerate with: cd phy && cmake -S . -B build && cmake --build build)
phy/build/
**/build/

# Compiled binaries / objects
*.o
*.obj
*.a
*.so
*.dylib
phy/sim/tx_app
phy/sim/rx_app
phy/tests/frontend_repro
phy/tests/pipeline2_verify
phy/tests/integration_test
phy/tests/mod_loopback_test
phy/tests/rx_chain_sweep
phy/tests/sync_reorder_demo

# Runtime output dirs written by the transceiver (created at the binary's CWD)
transmit/
received/
debugging/
**/transmit/
**/received/
**/debugging/

# Generated visualizations (figure output written by --viz and the Python tools)
phy_outputs/
**/phy_outputs/

# Training-run artifacts (torch models, plots, reward logs) — regenerable
applications/MARL_RA_Union/real_run.pt
applications/MARL_RA_Union/real_run.png
applications/MARL_RA_Union/real_run_rewards.txt
results/**/*.pt
results/**/*.pt.tmp

# Python bytecode
__pycache__/
*.pyc

# Misc
.DS_Store
*.txt.bak
