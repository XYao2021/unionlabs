# CMake build tree (regenerate with: cd drivers/usrp && cmake -S . -B build && cmake --build build)
drivers/usrp/build/
**/build/

# Compiled binaries / objects
*.o
*.obj
*.a
*.so
*.dylib
drivers/usrp/sim/tx_app
drivers/usrp/sim/rx_app
drivers/usrp/tests/frontend_repro
drivers/usrp/tests/pipeline2_verify
drivers/usrp/tests/integration_test
drivers/usrp/tests/mod_loopback_test
drivers/usrp/tests/rx_chain_sweep
drivers/usrp/tests/sync_reorder_demo

# Runtime output dirs written by the transceiver (created at the binary's CWD)
transmit/
received/
debugging/
**/transmit/
**/received/
**/debugging/

# Generated visualizations (--viz output and the plots made from it). The C++
# default --viz-dir is now results/phy_outputs, relative to the process CWD; the
# bare phy_outputs/ rules stay so output from an older binary is still ignored.
results/phy_outputs/
phy_outputs/
**/phy_outputs/

# Training-run artifacts (torch models, plots, reward logs) — regenerable
workspace/experiments/algorithms/marl_multi/real_run.pt
workspace/experiments/algorithms/marl_multi/real_run.png
workspace/experiments/algorithms/marl_multi/real_run_rewards.txt
results/**/*.pt
results/**/*.pt.tmp

# Per-node logs from ./run.sh topology <name> — one file per node, regenerable
results/topology/

# Python bytecode
__pycache__/
*.pyc

# Misc
.DS_Store
*.txt.bak

# Pandoc LaTeX intermediates — regenerated with the PDFs by
# drivers/usrp/tools/build_*_pdf.sh. The .md is the source; .pandoc-header.tex is NOT one.
docs/*.tex
!docs/.pandoc-header.tex

# Testbed SSH credentials — the real file NEVER enters the repo.
# Only credentials.sh.example (the template) is committed.
drivers/lora/deploy/credentials.sh
**/credentials.sh
**/device_credentials.sh

# Exported container images (multi-GB tarballs) — rebuild with
# deploy/docker/build-unionlabs.sh --export
results/images/

# LaTeX build artifacts (paper/)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz
